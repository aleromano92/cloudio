[Unit]
Description=cloudio nightly backup (vzdump{% if restic_enabled | bool %} + restic{% endif %})
Wants=network-online.target
After=network-online.target
RequiresMountsFor={{ archive_disk_mount }}

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/cloudio-nightly-backup.sh
Nice=10
IOSchedulingClass=idle
