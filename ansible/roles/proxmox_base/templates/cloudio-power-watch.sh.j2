#!/usr/bin/env bash
# Managed by Ansible (proxmox_base/power_watch.yml).
set -uo pipefail

UPS="{{ ups_name }}@localhost"
AC="/sys/class/power_supply/{{ power_watch_ac }}/online"
BAT="/sys/class/power_supply/{{ power_watch_battery }}/capacity"
UPS_MIN_RUNTIME=$(( {{ power_watch_ups_min_runtime_minutes }} * 60 ))
GRACE=$(( {{ power_watch_grace_minutes }} * 60 ))
MIN_BATTERY={{ power_watch_min_battery }}
RESTORE=$(( {{ power_watch_restore_minutes }} * 60 ))
STOPPED=/run/cloudio-power-watch.stopped
NODE=$(hostname)

on_battery_since=""
on_laptop_since=""
on_mains_since=""
ups_link=""
ups_vars=""

battery() { cat "$BAT" 2>/dev/null || echo "?"; }
ups_get() { sed -n "s/^$1: //p" <<<"$ups_vars"; }
is_number() { [[ $1 =~ ^[0-9]+$ ]]; }

ups_summary() {
  local s="UPS at ${charge:-?}%"
  is_number "$runtime" && s+=", ~$(( runtime / 60 )) min left"
  echo "$s"
}

stop_guests() {
  echo "$1; shutting the guests down"
  touch "$STOPPED"
  pvesh create "/nodes/$NODE/stopall" --timeout 180
  echo "guests stopped"
}

while true; do
  now=$(date +%s)

  ups_vars=$(upsc "$UPS" 2>/dev/null) || ups_vars=""
  status=$(ups_get ups.status)
  charge=$(ups_get battery.charge)
  runtime=$(ups_get battery.runtime)
  ups_ob=0; ups_lb=0
  [[ " $status " == *" OB "* ]] && ups_ob=1
  [[ " $status " == *" LB "* ]] && ups_lb=1
  if [ -n "$ups_vars" ]; then
    [ "$ups_link" != ok ] && echo "UPS readable: $status; $(ups_summary)"
    ups_link=ok
  else
    [ "$ups_link" != unreadable ] && echo "UPS unreadable; going by the laptop's adapter alone"
    ups_link=unreadable
  fi
  ac=$(cat "$AC" 2>/dev/null || echo 1)

  if [ "$ups_ob" = 1 ] || [ "$ac" = 0 ]; then
    on_mains_since=""
    if [ -z "$on_battery_since" ]; then
      on_battery_since=$now
      if [ "$ups_ob" = 1 ]; then
        echo "mains lost; the UPS is on battery: $(ups_summary)"
      fi
    fi
    if [ "$ac" = 0 ]; then
      if [ -z "$on_laptop_since" ]; then
        on_laptop_since=$now
        echo "laptop adapter offline; on its own battery at $(battery)%"
      fi
    else
      on_laptop_since=""
    fi

    if [ ! -e "$STOPPED" ]; then
      bat=$(battery)
      if [ "$ups_ob" = 1 ] && { [ "$ups_lb" = 1 ] \
           || { is_number "$runtime" && [ "$runtime" -le "$UPS_MIN_RUNTIME" ]; }; }; then
        stop_guests "UPS low after $(( (now - on_battery_since) / 60 )) min on battery ($status); $(ups_summary)"
      elif [ -n "$on_laptop_since" ] \
           && { [ $(( now - on_laptop_since )) -ge "$GRACE" ] \
                || { [ "$bat" != "?" ] && [ "$bat" -le "$MIN_BATTERY" ]; }; }; then
        stop_guests "laptop on its own battery for $(( (now - on_laptop_since) / 60 )) min, at ${bat}%"
      fi
    fi
  else
    if [ -n "$on_battery_since" ]; then
      msg="mains back after $(( (now - on_battery_since) / 60 )) min; laptop battery at $(battery)%"
      [ -n "$ups_vars" ] && msg+=", $(ups_summary)"
      echo "$msg"
      on_battery_since=""
      on_laptop_since=""
    fi
    if [ -e "$STOPPED" ]; then
      [ -z "$on_mains_since" ] && on_mains_since=$now
      if [ $(( now - on_mains_since )) -ge "$RESTORE" ]; then
        echo "mains steady for {{ power_watch_restore_minutes }} min; starting the onboot guests"
        pvesh create "/nodes/$NODE/startall" && rm -f "$STOPPED"
        on_mains_since=""
      fi
    fi
  fi
  sleep 15
done
