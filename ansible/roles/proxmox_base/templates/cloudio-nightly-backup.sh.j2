#!/usr/bin/env bash
# Managed by Ansible (proxmox_base/backup.yml). Refine freely.
#
# 1. vzdump each guest to the local backup storage, which prunes old dumps
#    to its retention ({{ backup_prune }})
{% if restic_enabled | bool %}
# 2. restic backup: host config paths + the local dumps -> Hetzner Storage Box
# 3. restic forget --prune to the retention policy
{% endif %}
set -euo pipefail

echo "=== $(date -Is) vzdump ==="
vzdump {{ backup_guest_ids | join(' ') }} --storage {{ backup_storage_id }} \
  --mode snapshot --compress zstd --quiet 1
{% if restic_enabled | bool %}

set -a
# shellcheck disable=SC1091
. /etc/cloudio-backup.env
set +a

echo "=== $(date -Is) restic backup ==="
restic backup --tag nightly {{ restic_paths | join(' ') }} "{{ backup_local_path }}/dump"

echo "=== $(date -Is) restic forget --prune ==="
restic forget \
  --keep-daily {{ restic_keep_daily }} \
  --keep-weekly {{ restic_keep_weekly }} \
  --prune
{% endif %}

echo "=== $(date -Is) done ==="
