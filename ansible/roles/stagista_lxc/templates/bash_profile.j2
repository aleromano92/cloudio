# Managed by Ansible (stagista_lxc role).
[ -f ~/.bashrc ] && . ~/.bashrc
export PATH="$HOME/.local/bin:$PATH"

# An SSH login lands in the one persistent tmux session, running Claude Code
# in the repo. Disconnecting leaves it running; the next login reattaches.
# For a plain shell instead: ssh -t stagista NO_TMUX=1 bash -l
if [ -n "$SSH_CONNECTION" ] && [ -z "$TMUX" ] && [ -z "${NO_TMUX:-}" ] && [ -t 0 ]; then
    exec tmux new-session -A -s claude -c {{ stagista_workdir }}/cloudio "claude; exec bash -l"
fi
