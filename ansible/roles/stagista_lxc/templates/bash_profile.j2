# Managed by Ansible (stagista_lxc role).
[ -f ~/.bashrc ] && . ~/.bashrc
export PATH="$HOME/.local/bin:$PATH"

# A plain SSH login lands in cloudio's persistent tmux session, running Claude
# Code. Disconnecting leaves it running; the next login reattaches. Other repos
# get their own session: ssh -t stagista '~/.local/bin/proj <folder>'
# For a plain shell instead: ssh -t stagista NO_TMUX=1 bash -l
if [ -n "$SSH_CONNECTION" ] && [ -z "$TMUX" ] && [ -z "${NO_TMUX:-}" ] && [ -t 0 ]; then
    exec proj cloudio
fi
