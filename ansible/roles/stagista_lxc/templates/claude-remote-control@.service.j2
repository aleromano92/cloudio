# Managed by Ansible (stagista_lxc role).
[Unit]
Description=Claude Code Remote Control server for %i
Wants=network-online.target
After=network-online.target

[Service]
User={{ stagista_user }}
WorkingDirectory={{ stagista_workdir }}/%i
Environment=PATH=/home/{{ stagista_user }}/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/{{ stagista_user }}/.local/bin/claude remote-control --name %i --no-create-session-in-dir
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
