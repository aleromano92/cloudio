[Unit]
Description=cloudio daytime band lock (LTE B{{ band_day_lte }} + NR n{{ band_day_nr }})
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# The router accepts one logged-in session at a time and answers an evicted
# one with empty strings rather than an error, so two of our own jobs talking
# to it at once would silently corrupt each other's readings. One lock, held
# for as long as the job talks to the router.
ExecStart=/usr/bin/flock --wait 300 /run/lock/cloudio-zte.lock /usr/local/sbin/cloudio-band-day.sh
# Covers the lock wait plus the band change and its settle.
TimeoutStartSec=600
