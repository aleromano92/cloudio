[Unit]
Description=cloudio daytime band lock (LTE B{{ band_day_lte | join('+B') }} + NR n{{ band_day_nr }})
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/flock --wait 300 /run/lock/cloudio-zte.lock /usr/local/sbin/cloudio-band-day.sh
TimeoutStartSec=600
