[Unit]
Description=cloudio nightly band unlock + probe + lock best
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# The router accepts one logged-in session at a time and answers an evicted
# one with empty strings rather than an error, so two of our own jobs talking
# to it at once would silently corrupt each other's readings. One lock, held
# for as long as the job talks to the router.
ExecStart=/usr/bin/flock --wait 300 /run/lock/cloudio-zte.lock /usr/local/sbin/cloudio-band-night.sh
# The probe sweep changes band and waits for the modem to re-register once per
# candidate, so this legitimately runs for minutes.
TimeoutStartSec={{ band_night_timeout_seconds }}
