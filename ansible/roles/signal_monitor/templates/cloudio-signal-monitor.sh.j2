#!/bin/bash
# Managed by Ansible (signal_monitor role). Appends one JSON line per run to
# {{ signal_log_dir }}/metrics.jsonl: ZTE MC801A 5G/LTE signal + a speedtest
# sample. Best-effort -- a failure in one half still logs the other half,
# and this must never spam MAX_LOGIN_COUNT lockouts on the router (see the
# zte_router_enabled gate in main, baked in at template time on purpose).
#
# Sourcing this file defines the functions without running a sample, so the
# router session can be checked on its own:
#   . /usr/local/sbin/cloudio-signal-monitor.sh
#   . /etc/cloudio-signal-monitor.env
#   zte_read_signal {{ zte_router_ip }} "$ZTE_PASSWORD" | jq .
set -uo pipefail

. /usr/local/lib/cloudio/zte-session.sh

# cell_id is the full E-UTRAN cell identity; its leading digits are the
# enodeb_id (the site/BTS), so a change in enodeb_id means the modem moved to
# a different mast, not just a different sector. ngbr_cell_info lists the
# neighbours it could see at that moment, which is what says whether a better
# cell existed at all.
ZTE_FIELDS=network_type,lte_rsrp,lte_rsrq,lte_snr,lte_rssi,Z5g_rsrp,Z5g_SINR,wan_lte_ca,lte_ca_pcell_band,cell_id,enodeb_id,lte_pci,nr5g_pci,lte_band,nr5g_action_band,ngbr_cell_info,wan_ipaddr,pm_sensor_mdm,pm_modem_5g

# Logs in to the router and prints one JSON object on stdout: the normalised
# signal fields plus login_ok:true, or {login_ok:false, error:...}. Always
# prints valid JSON; never exits non-zero. Typing and sentinel handling live in
# the session library, so metrics.jsonl and the band scheduler agree on what a
# missing reading looks like.
zte_read_signal() {
  local router_ip=$1 password=$2 jar signal
  if [ -z "$password" ]; then
    jq -nc '{login_ok: false, error: "no_password_configured"}'
    return 0
  fi

  jar=$(mktemp)
  if ! zte_login "$router_ip" "$password" "$jar"; then
    rm -f "$jar"
    jq -nc '{login_ok: false, error: "login_failed"}'
    return 0
  fi

  signal=$(zte_status "$router_ip" "$jar" "$ZTE_FIELDS")
  # The router keeps one session at a time: opening its web UI in a browser
  # evicts this one, and an evicted session gets every field back blank rather
  # than an error. One re-login tells that apart from a genuine loss of signal,
  # which is worth recording as the null it is.
  if printf '%s' "$signal" | jq -e '.lte_rsrp == null and .wan_ipaddr == null' >/dev/null 2>&1; then
    zte_login "$router_ip" "$password" "$jar" >/dev/null 2>&1
    signal=$(zte_status "$router_ip" "$jar" "$ZTE_FIELDS")
  fi
  rm -f "$jar"

  if printf '%s' "$signal" | jq -e 'length > 0' >/dev/null 2>&1; then
    printf '%s' "$signal" | jq -ce '. + {login_ok: true}'
  else
    jq -nc '{login_ok: false, error: "bad_signal_response"}'
  fi
}

# Prints one JSON object with the speedtest result, or null on failure.
speedtest_sample() {
  local raw
  # The Ookla CLI prints its license/GDPR banner to stdout (not stderr) on
  # first acceptance -- the JSON result is always the last line either way.
  raw=$(/usr/local/bin/speedtest --format=json --accept-license --accept-gdpr 2>/dev/null | tail -n 1)
  printf '%s' "$raw" | jq -ce '{
    ping_ms: .ping.latency,
    jitter_ms: .ping.jitter,
    download_mbps: (.download.bandwidth * 8 / 1000000),
    upload_mbps: (.upload.bandwidth * 8 / 1000000),
    server: .server.name,
    server_location: .server.location
  }' 2>/dev/null || echo null
}

main() {
  local env_file=/etc/cloudio-signal-monitor.env
  # shellcheck disable=SC1090
  [ -r "$env_file" ] && . "$env_file"

  local log_dir="{{ signal_log_dir }}"
  mkdir -p "$log_dir"

  local ts zte speedtest
  ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
{% if zte_router_enabled %}
  zte=$(zte_read_signal "{{ zte_router_ip }}" "${ZTE_PASSWORD:-}")
{% else %}
  zte=$(jq -nc '{login_ok: false, error: "disabled"}')
{% endif %}
  speedtest=$(speedtest_sample)

  jq -nc --arg ts "$ts" --argjson zte "$zte" --argjson speedtest "$speedtest" \
    '{timestamp: $ts, zte: $zte, speedtest: $speedtest}' >> "$log_dir/metrics.jsonl"
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main
fi
