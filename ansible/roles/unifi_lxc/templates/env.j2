# Rendered by Ansible (unifi_lxc role). Read by docker compose in /opt/unifi-stack.
PUID={{ unifi_puid }}
PGID={{ unifi_pgid }}
TZ={{ timezone }}
APPDATA=/opt/appdata
MONGO_INITDB_ROOT_USERNAME={{ unifi_mongo_root_user }}
MONGO_INITDB_ROOT_PASSWORD={{ vault_unifi_mongo_root_password }}
MONGO_USER={{ unifi_mongo_user }}
MONGO_PASS={{ vault_unifi_mongo_user_password }}
MONGO_DBNAME={{ unifi_mongo_dbname }}
MONGO_AUTHSOURCE={{ unifi_mongo_authsource }}
