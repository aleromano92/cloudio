---
# Copy this file to vault.yml, fill in real values, then encrypt it:
#
#   cp group_vars/all/vault.yml.example group_vars/all/vault.yml
#   $EDITOR group_vars/all/vault.yml
#   ansible-vault encrypt group_vars/all/vault.yml
#
# Run the playbook with:  ansible-playbook site.yml --ask-vault-pass
#
# The encrypted vault.yml IS committed. This .example file is the only
# plaintext one and contains no real secrets.

# Tailscale one-off auth key: https://login.tailscale.com/admin/settings/keys
# A reusable or ephemeral key is fine.
vault_tailscale_auth_key: "tskey-auth-XXXXXXXXXXXXXXXX"

# restic repository password. Generate a long random string and STORE IT IN
# YOUR PASSWORD MANAGER. Lose it and the off-site backups are unrecoverable.
vault_restic_password: "generate-a-long-random-passphrase"

# UniFi's dedicated MongoDB — two separate random strings, saved in your
# password manager too (though these are less catastrophic to lose: worst
# case is recreating the LXC).
vault_unifi_mongo_root_password: "generate-a-long-random-passphrase"
vault_unifi_mongo_user_password: "generate-a-long-random-passphrase"

# ZTE MC801A router admin password (plaintext here -- the monitor script
# hashes it client-side the same way the router's own web UI does before
# ever sending it). Only used if zte_router_enabled: true.
vault_zte_router_password: "CHANGE-ME"

# SMTP relay password for the daily signal digest email (e.g. a Gmail app
# password). Only used if signal_email_enabled: true.
vault_signal_email_smtp_password: "CHANGE-ME"
