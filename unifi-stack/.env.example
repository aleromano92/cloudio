# Ansible renders the real .env from group_vars + vault (unifi_lxc role). This
# example is for running the stack by hand while testing.
PUID=1000
PGID=1000
TZ=Europe/Rome
APPDATA=/opt/appdata
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGO_USER=unifi
MONGO_PASS=changeme
MONGO_DBNAME=unifi
MONGO_AUTHSOURCE=admin
