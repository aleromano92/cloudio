# Caddy: HTTPS from the internet for Jellyfin and Home Assistant. Deployed
# next to docker-compose.yaml by ansible/roles/media_lxc.
#
# The ZTE forwards only TCP 443 to this container, so Let's Encrypt can only
# verify the domain over 443 itself (TLS-ALPN-01); the HTTP challenge is
# disabled rather than left to time out on a port the internet can't reach.
# The certificate and its key live in ${APPDATA}/caddy/data, at home: nothing
# upstream can decrypt the streams.
#
# JELLYFIN_HOST, HA_HOST and HA_UPSTREAM come from .env; ansible/roles/ddns keeps
# both names pointing at the home IP, which the 5G operator changes several
# times a day. Any other name gets no certificate and no answer.

{$JELLYFIN_HOST} {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}

	# Jellyfin runs on host networking in the same container. Caddy passes the
	# client's address in X-Forwarded-For; Jellyfin only believes it because
	# 127.0.0.1 is in its KnownProxies (network.xml), which is what makes
	# friends count as remote rather than local.
	reverse_proxy 127.0.0.1:8096
}

{$HA_HOST} {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}

	# The family's Companion apps. Home Assistant runs in its own VM; it only
	# accepts proxied requests because this container's IP is in its
	# http.trusted_proxies, and reads the client's address from
	# X-Forwarded-For, so its failed-login bans hit the attacker, not Caddy.
	# WebSockets (the app's live connection) pass through as-is.
	reverse_proxy {$HA_UPSTREAM}
}
