{$JELLYFIN_HOST} {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}

	reverse_proxy 127.0.0.1:8096
}

{$HA_HOST} {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}

	reverse_proxy {$HA_UPSTREAM}
}

